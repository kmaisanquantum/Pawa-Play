# ==== Regulatory posture ====
# DEMO: simulated money everywhere, KYC not enforced, safe for local dev.
# TEST: simulated money, full rules enforced (for QA/regression against real logic).
# PRODUCTION: real money — requires JURISDICTION_CODE, MINIMUM_AGE, LICENCE_REFERENCE,
#             and at least one approved row in payment_providers. Never set this
#             from a UI toggle; it's read once at process boot.
REGULATORY_MODE=DEMO

# ==== Jurisdiction (never hard-code these in code — operator supplies them) ====
JURISDICTION_CODE=
CURRENCY_CODE=PGK
MINIMUM_AGE=18
LICENCE_REFERENCE=
AML_THRESHOLD_AMOUNT=
DEFAULT_DEPOSIT_LIMIT=
DEFAULT_BET_LIMIT=
DEFAULT_LOSS_LIMIT=

# ==== Infra ====
DATABASE_URL=postgres://pawaplay:pawaplay_dev_only@localhost:5432/pawaplay
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://pawaplay:pawaplay_dev_only@localhost:5672

# ==== Auth ====
JWT_SECRET=change-me-in-every-environment
JWT_REFRESH_SECRET=change-me-too
PORT=3000

# ==== OTP / SMS / WhatsApp / Push (Phase 3) ====
OTP_PROVIDER=console      # 'console' logs OTP locally in DEMO; swap for real SMS provider later
SMS_PROVIDER_API_KEY=
WHATSAPP_BUSINESS_API_TOKEN=
PUSH_NOTIFICATION_KEY=

# ==== Payment providers (Phase 3) ====
# Add one block per approved provider; 'sandbox' ships for local dev only.
PAYMENT_PROVIDER_SANDBOX_ENABLED=true
